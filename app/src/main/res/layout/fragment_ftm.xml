<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ios_bg">

    <!-- iOS Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/ios_nav_bar"
        android:elevation="2dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WiFi FTM"
            android:textColor="@color/ios_label"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingVertical="14dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/ios_separator" />
    </LinearLayout>

    <!-- Device Support Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="裝置支援"
            style="@style/SectionHeader"
            android:paddingBottom="6dp"
            android:paddingHorizontal="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/ios_card"
            android:padding="14dp">

            <!-- 802.11mc -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/ios_support_badge"
                android:padding="10dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:id="@+id/tvMcIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="802.11mc"
                    android:textColor="@color/ios_label"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvMcStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="確認中"
                    android:textSize="11sp"
                    android:textColor="@color/ios_secondary_label" />
            </LinearLayout>

            <!-- 802.11az -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/ios_support_badge"
                android:padding="10dp"
                android:layout_marginHorizontal="6dp">

                <TextView
                    android:id="@+id/tvAzIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="802.11az"
                    android:textColor="@color/ios_label"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvAzStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="確認中"
                    android:textSize="11sp"
                    android:textColor="@color/ios_secondary_label" />
            </LinearLayout>

            <!-- RTT Available -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/ios_support_badge"
                android:padding="10dp"
                android:layout_marginStart="6dp">

                <TextView
                    android:id="@+id/tvRttIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RTT Ready"
                    android:textColor="@color/ios_label"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvRttStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="確認中"
                    android:textSize="11sp"
                    android:textColor="@color/ios_secondary_label" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScan"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="掃描"
            android:textSize="14sp"
            app:cornerRadius="18dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="@color/ios_blue"
            android:textColor="@color/ios_blue" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartRanging"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:text="開始測距"
            android:textSize="14sp"
            android:enabled="false"
            app:cornerRadius="18dp"
            app:backgroundTint="@color/ios_green" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="間隔 "
            android:textColor="@color/ios_secondary_label"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etInterval"
            android:layout_width="52dp"
            android:layout_height="32dp"
            android:text="1000"
            android:inputType="number"
            android:textColor="@color/ios_label"
            android:textSize="13sp"
            android:padding="4dp"
            android:gravity="center"
            android:background="@drawable/ios_support_badge" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" ms"
            android:textColor="@color/ios_secondary_label"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Status + result count -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="6dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="就緒"
            android:textColor="@color/ios_secondary_label"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvResultCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="結果: 0"
            android:textColor="@color/ios_secondary_label"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- AP Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="  可用 AP"
        style="@style/SectionHeader"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAccessPoints"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/ios_bg"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp" />

    <!-- Results Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="測距結果"
            style="@style/SectionHeader" />

        <CheckBox
            android:id="@+id/cbAutoScroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="自動捲動"
            android:textColor="@color/ios_secondary_label"
            android:textSize="12sp"
            android:checked="true"
            android:buttonTint="@color/ios_blue" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClear"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:text="清除"
            android:textSize="12sp"
            app:cornerRadius="14dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="@color/ios_secondary_label"
            android:textColor="@color/ios_secondary_label" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:background="@color/ios_bg"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp" />

</LinearLayout>
