<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ios_bg">

    <!-- iOS Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/ios_nav_bar"
        android:elevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="10dp"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Beacon 查看器"
                android:textColor="@color/ios_label"
                android:textSize="17sp"
                android:textStyle="bold"
                android:gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBeaconScan"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="掃描"
                android:textSize="14sp"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/ios_blue" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/ios_separator" />
    </LinearLayout>

    <!-- Status + warning -->
    <TextView
        android:id="@+id/tvBeaconStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="點擊「掃描」開始"
        android:textColor="@color/ios_secondary_label"
        android:textSize="13sp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp" />

    <TextView
        android:id="@+id/tvBeaconNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ios_orange"
        android:textSize="12sp"
        android:paddingHorizontal="20dp"
        android:paddingBottom="4dp"
        android:text="" />

    <!-- AP List -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="  存取點"
        style="@style/SectionHeader"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="6dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBeaconAps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/ios_bg"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp" />

</LinearLayout>
