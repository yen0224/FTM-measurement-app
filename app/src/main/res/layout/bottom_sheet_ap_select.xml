<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ios_cell_bg">

    <!-- Drag handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@color/ios_separator" />

    <!-- Header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="選擇 AP"
            android:textColor="@color/ios_label"
            android:textSize="17sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetScan"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="掃描"
            android:textSize="13sp"
            app:cornerRadius="16dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="@color/ios_blue"
            android:textColor="@color/ios_blue" />
    </LinearLayout>

    <!-- Separator -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/ios_separator" />

    <!-- AP list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSheetAps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp" />

    <!-- Separator -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/ios_separator" />

    <!-- Done button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSheetDone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:text="完成"
        android:textSize="15sp"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/ios_blue" />

</LinearLayout>
